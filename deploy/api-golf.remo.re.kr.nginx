# api-golf.remo.re.kr — 파크골프 백엔드 API
# 배치: sudo cp deploy/api-golf.remo.re.kr.nginx /etc/nginx/sites-available/api-golf.remo.re.kr
#       sudo ln -s /etc/nginx/sites-available/api-golf.remo.re.kr /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
#       sudo certbot --nginx -d api-golf.remo.re.kr
server {
    server_name api-golf.remo.re.kr;

    # NestJS fileSize 상한(100MB)과 일치시킨다
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 대용량 업로드를 버퍼링 없이 흘려보낸다
        proxy_request_buffering off;

        # 결과 조회가 REMO 를 호출할 수 있어 여유를 둔다 (기본 60s 로는 부족)
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
    }

    listen 80;
}
